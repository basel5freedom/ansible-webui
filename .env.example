# このファイルをコピーして .env 等に保存し、systemdのEnvironmentFile等で読み込む。
# 値はここに書かず、実際のデプロイ先でのみ設定すること（.envはGit等にコミットしない）。

# ログイン用ユーザー名
WEBUI_USERNAME=admin

# ログイン用パスワードのbcryptハッシュ（ hash_password.py で生成する）
WEBUI_PASSWORD_HASH=

# セッション署名用の鍵（ランダムな長い文字列。例: python -c "import secrets; print(secrets.token_hex(32))"）
WEBUI_SESSION_SECRET=

# config.ymlの配置場所を変える場合のみ指定（省略時はwebui/config.yml）
# WEBUI_CONFIG=/etc/ansible-webui/config.yml

# ジョブログの保存先を変える場合のみ指定（省略時はwebui/logs）
# WEBUI_LOG_DIR=/var/log/ansible-webui
